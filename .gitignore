# Dependencies
/node_modules/
/vendor/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDEs and editors
/.idea/
/.vscode/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Cache and temporary files
/cache/
/tmp/
/temp/

# Build output: ignore everything except deployment assets
# Production build: keep CSS and manifest for deployment
/public/build/*
!/public/build/.gitignore
!/public/build/manifest.json
!/public/build/*.css
# Coverage and test output
/coverage/

# Local database files
*.sqlite
*.sqlite3